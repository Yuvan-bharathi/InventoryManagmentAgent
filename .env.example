# Copy to .env (never commit .env). `neon init` writes the Neon values for you.
# Neon pooled connection (app runtime, host contains -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon direct connection (Alembic migrations)
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Day 2 (agent)
DOMO_INSTANCE=
DOMO_DEVELOPER_TOKEN=
DOMO_MODEL_ID=
JWT_SECRET=

# Tests only — a separate Neon branch (e.g. "tests", branched from main). pytest and Playwright use these
# and never touch main. Without them the database tests are skipped and Playwright refuses to start.
TEST_DATABASE_URL=
TEST_DATABASE_URL_DIRECT=
